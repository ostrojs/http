{
    "name": "@ostro/http",
    "version": "2.0.0-alpha.1",
    "description": "HTTP module for OstroJS",
    "main": "build/httpContext.js",
    "types": "build/httpContext.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/httpContext.d.ts",
            "default": "./build/httpContext.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "accepts": "^1.3.8",
        "array-flatten": "^3.0.0",
        "body-parser": "^1.20.3",
        "busboy": "^1.6.0",
        "bytes": "3.1.0",
        "compressible": "2.0.18",
        "content-disposition": "^0.5.4",
        "content-type": "^1.0.4",
        "cors": "^2.8.5",
        "encodeurl": "^1.0.2",
        "escape-html": "^1.0.3",
        "etag": "^1.8.1",
        "fresh": "^0.5.2",
        "lodash": "^4.17.21",
        "methods": "^1.1.2",
        "on-finished": "^2.3.0",
        "on-headers": "1.0.2",
        "parseurl": "^1.3.3",
        "path-to-regexp": "^6.2.0",
        "proxy-addr": "^2.0.8",
        "qs": "^6.10.0",
        "range-parser": "^1.2.1",
        "safe-buffer": "^5.2.0",
        "send": "^0.19.0",
        "serve-static": "^1.16.2",
        "statuses": "^1.5.0",
        "type-is": "^1.6.18",
        "utils-merge": "^1.0.1",
        "uuid": "^11.1.0",
        "vary": "^1.1.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "http"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/http.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/http/issues"
    },
    "homepage": "https://github.com/ostrojs/http#readme",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "c8": "^12.0.0",
        "jest": "^30.5.1",
        "supertest": "^7.2.2",
        "typescript": "^5.8.0"
    }
}
