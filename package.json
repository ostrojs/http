{
    "name": "@ostro/http",
    "version": "2.0.0-alpha.6",
    "description": "HTTP module for OstroJS",
    "main": "httpContext.js",
    "types": "types/httpContext.d.ts",
    "exports": {
        ".": {
            "types": "./types/httpContext.d.ts",
            "default": "./httpContext.js"
        },
        "./*": {
            "types": "./types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.6",
        "@ostro/support": "^2.0.0-alpha.7",
        "accepts": "^1.3.8",
        "body-parser": "^1.20.3",
        "busboy": "^1.6.0",
        "bytes": "^3.1.2",
        "compressible": "^2.0.18",
        "content-disposition": "^0.5.4",
        "content-type": "^1.0.5",
        "cors": "^2.8.6",
        "encodeurl": "^1.0.2",
        "escape-html": "^1.0.3",
        "etag": "^1.8.1",
        "fresh": "^0.5.2",
        "lodash": "^4.17.21",
        "methods": "^1.1.2",
        "on-finished": "^2.4.1",
        "on-headers": "^1.1.0",
        "parseurl": "^1.3.3",
        "path-to-regexp": "^6.2.0",
        "proxy-addr": "^2.0.8",
        "qs": "^6.14.0",
        "range-parser": "^1.3.0",
        "safe-buffer": "^5.2.1",
        "send": "^0.19.0",
        "serve-static": "^1.16.2",
        "statuses": "^1.5.0",
        "type-is": "^1.6.18",
        "uuid": "^11.1.1",
        "vary": "^1.1.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "http"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/http.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/http/issues"
    },
    "homepage": "https://github.com/ostrojs/http#readme",
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0",
        "@ostro/builder": "^2.0.0-alpha.4"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
